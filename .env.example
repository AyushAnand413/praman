# BAZAAR universal local environment template.
#
# Copy this file to `.env` and fill values there. `.env` is gitignored and must
# never be committed. Keep all secrets out of source code and prompts.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# shadow = compute every verdict, write receipts/ledger, call no payment API.
# live   = execute approved money actions against Razorpay test mode.
POLICY_MODE=shadow


# ---------------------------------------------------------------------------
# Razorpay test-mode credentials
# Required for real order creation, payment capture, refunds, and webhooks.
# Use only rzp_test_* keys. Never use live keys for this project.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# Policy receipts and mandates
# POLICY_RECEIPT_HMAC_SECRET: any long random string for signing receipts.
# MANDATE_SIGNING_SEED: 64 hex chars for the demo wallet Ed25519 signing key.
# Example seed shape only: 1111111111111111111111111111111111111111111111111111111111111111
# ---------------------------------------------------------------------------
POLICY_RECEIPT_HMAC_SECRET=
MANDATE_SIGNING_SEED=


# ---------------------------------------------------------------------------
# Merchant demo auth
# Used by /merchant/v1 approval routes in the demo dashboard.
# ---------------------------------------------------------------------------
DEMO_KEY=


# ---------------------------------------------------------------------------
# Phase 3 LLM
# Not needed for Phase 1/2 fixes. Required when Vyapaari/Gemini is enabled.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=


# ---------------------------------------------------------------------------
# Local app config
# Leave DATABASE_PATH empty to use data/bazaar.db.
# PUBLIC_BASE_URL should be the backend URL visible to agents/webhooks.
# ---------------------------------------------------------------------------
DATABASE_PATH=
DATA_DIR=
CATALOG_PATH=
DASHBOARD_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
MERCHANT_NAME=Aether Audio
